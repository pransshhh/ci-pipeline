{
	"name": "first-app",
	"version": "1.0.0",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"dev": "node --watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"keywords": [],
	"packageManager": "pnpm@10.28.2",
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@types/express": "^5.0.6",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"dotenv": "^17.3.1",
		"express": "^5.2.1"
	}
}
